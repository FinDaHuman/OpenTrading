{
  "name": "opentrading",
  "version": "0.5.1",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "description": "OpenTrading — AI harness TUI for Vietnamese equity research (demo v0)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FinDaHuman/OpenTrading.git"
  },
  "bin": {
    "opentrading": "./src/index.tsx"
  },
  "scripts": {
    "dev": "bun run ./src/index.tsx",
    "build": "bun ./scripts/build.ts",
    "install:global": "bun ./src/cli/install.ts",
    "uninstall:global": "bun ./src/cli/install.ts --uninstall",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=8 --timeout=20000"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.92",
    "@ai-sdk/anthropic": "4.0.106",
    "@ai-sdk/cerebras": "3.0.94",
    "@ai-sdk/cohere": "4.0.85",
    "@ai-sdk/deepinfra": "3.0.94",
    "@ai-sdk/google": "4.0.122",
    "@ai-sdk/groq": "4.0.85",
    "@ai-sdk/mistral": "4.0.88",
    "@ai-sdk/openai": "4.0.121",
    "@ai-sdk/openai-compatible": "3.0.93",
    "@ai-sdk/perplexity": "5.0.36",
    "@ai-sdk/togetherai": "3.0.95",
    "@ai-sdk/vercel": "3.0.30",
    "@ai-sdk/xai": "5.0.47",
    "@crafter/charts": "0.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentui/core": "0.9.7",
    "@opentui/solid": "0.9.7",
    "ai": "7.0.177",
    "ajv": "8.20.0",
    "linkedom": "0.18.15",
    "lru-cache": "11.5.3",
    "solid-js": "1.9.19",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2",
    "unpdf": "2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/turndown": "5.0.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "glob": "14.0.2",
    "minimatch": "11.0.8"
  },
  "patchedDependencies": {
    "babel-plugin-module-resolver@5.0.2": "patches/babel-plugin-module-resolver@5.0.2.patch"
  }
}
