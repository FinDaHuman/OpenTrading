{"shell":"bash","form":"awk-series-loop","source":"r0-gemini-flash-lite","task":"compute-12-drawdown","command":"awk 'BEGIN {\n    data = \"48.5 50.2 51.8 49.9 47.3 46.1 47.8 49 45.2 44.7 46.9 48.1\";\n    n = split(data, prices, \" \");\n    \n    max_price = 0;\n    max_drawdown = 0;\n    \n    for (i = 1; i <= n; i++) {\n        if (prices[i] > max_price) {\n            max_price = prices[i];\n        }\n        drawdown = (max_price - prices[i]) / max_price;\n        if (drawdown > max_drawdown) {\n            max_drawdown = drawdown;\n        }\n    }\n    printf \"%.3f\\n\", max_drawdown * 100;\n}'"}
{"shell":"powershell","form":"ps-series-loop","source":"r2-gemini-flash-lite","task":"compute-07-volatility","command":"$prices = @(61.2, 61.9, 61.4, 62.3, 63.1, 62.6, 62.9, 64, 63.5, 64.4, 65.1)\n$returns = New-Object System.Collections.Generic.List[double]\nfor ($i = 1; $i -lt $prices.Count; $i++) {\n    $r = [Math]::Log($prices[$i] / $prices[$i-1])\n    $returns.Add($r)\n}\n\n$mean = ($returns | Measure-Object -Average).Average\n$sumSq = 0\nforeach ($r in $returns) {\n    $sumSq += [Math]::Pow($r - $mean, 2)\n}\n$stdDev = [Math]::Sqrt($sumSq / ($returns.Count - 1))\n$annualizedVol = $stdDev * [Math]::Sqrt(250) * 100\n\"{0:N3}%\" -f $annualizedVol"}
