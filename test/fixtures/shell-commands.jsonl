{"shell":"bash","form":"awk-series-loop","source":"r0-gemini-flash-lite","task":"compute-07-volatility","command":"awk 'BEGIN {\n  split(\"61.2 61.9 61.4 62.3 63.1 62.6 62.9 64.0 63.5 64.4 65.1\", prices, \" \");\n  n = 11;\n  for (i = 1; i < n; i++) {\n    log_returns[i] = log(prices[i+1] / prices[i]);\n  }\n  \n  sum = 0;\n  for (i = 1; i < 10; i++) sum += log_returns[i];\n  mean = sum / 10;\n  \n  sq_diff_sum = 0;\n  for (i = 1; i < 10; i++) sq_diff_sum += (log_returns[i] - mean)^2;\n  std_dev = sqrt(sq_diff_sum / (10 - 1));\n  \n  volatility = std_dev * sqrt(250) * 100;\n  printf \"%.3f\\n\", volatility;\n}'"}
