{"shell":"powershell","form":"ps-series-loop","source":"r0-gemini-flash-lite","task":"compute-07-volatility","command":"$prices = @(61.2, 61.9, 61.4, 62.3, 63.1, 62.6, 62.9, 64.0, 63.5, 64.4, 65.1)\n$returns = for ($i = 1; $i -lt $prices.Count; $i++) { [Math]::Log($prices[$i] / $prices[$i-1]) }\n$n = $returns.Count\n$mean = ($returns | Measure-Object -Average).Average\n$variance = ($returns | ForEach-Object { [Math]::Pow($_ - $mean, 2) } | Measure-Object -Sum).Sum / ($n - 1)\n$stdDev = [Math]::Sqrt($variance)\n$annualized = $stdDev * [Math]::Sqrt(250) * 100\n[Math]::Round($annualized, 3)"}
