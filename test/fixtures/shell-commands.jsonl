{"shell":"bash","form":"awk-series-loop","source":"r0-gemini-flash-lite","task":"compute-05-volume","command":"awk 'BEGIN{\n    data = \"12000000 13419003 14838006 16257009 17676012 12595015 14014018 15433021 16852024 18271027 13190030 14609033 16028036 17447039 12366042 13785045 15204048 16623051 18042054 12961057 14380060 15799063 17218066 12137069 13556072 14975075 16394078 17813081 12732084 14151087\";\n    n = split(data, a, \" \");\n    sum = 0;\n    for(i=1; i<=n; i++) sum += a[i];\n    avg = sum / n;\n    last = a[n];\n    printf \"%.2f\\n\", (last / avg) * 100;\n}'"}
