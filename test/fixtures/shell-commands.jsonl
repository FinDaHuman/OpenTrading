{"shell":"bash","form":"awk-series-loop","source":"r0-gemini-flash-lite","task":"compute-12-drawdown","command":"awk 'BEGIN {\n    data = \"48.5 50.2 51.8 49.9 47.3 46.1 47.8 49 45.2 44.7 46.9 48.1\";\n    n = split(data, prices, \" \");\n    \n    max_price = 0;\n    max_drawdown = 0;\n    \n    for (i = 1; i <= n; i++) {\n        if (prices[i] > max_price) {\n            max_price = prices[i];\n        }\n        drawdown = (max_price - prices[i]) / max_price;\n        if (drawdown > max_drawdown) {\n            max_drawdown = drawdown;\n        }\n    }\n    printf \"%.3f\\n\", max_drawdown * 100;\n}'"}
