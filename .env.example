# Copy to .env and fill only the providers you use. Never commit .env.
OPENTRADING_ENVIRONMENT=local
OPENTRADING_LOG_LEVEL=INFO
OPENTRADING_SESSION_DATABASE=~/.opentrading/sessions.sqlite3

# Internal data APIs. Uncomment only after the integration is verified.
# OPENTRADING_DONGANH_CAPITAL_BASE_URL=https://api.example.invalid
# OPENTRADING_DONGANH_CAPITAL_TOKEN=replace-me
# OPENTRADING_TRADING_AGENTS_BASE_URL=https://api.example.invalid
# OPENTRADING_TRADING_AGENTS_TOKEN=replace-me

# LLM credentials are reserved for future adapters.
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me
